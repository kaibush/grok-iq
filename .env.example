# Bootstrap settings (restart required)
TZ=Asia/Shanghai
# Optional build/runtime override; Docker tag builds inject the tag automatically.
GROKIQ_VERSION=
GROKIQ_HOST=0.0.0.0
GROKIQ_PORT=8090
GROKIQ_DATABASE_PATH=./data/grokiq.db
GROKIQ_RUNTIME_SECRET_KEY=
# Leave empty to generate grokiq.jwt.key beside the database (minimum 32 bytes when set).
GROKIQ_JWT_SECRET_KEY=
# JWT lifetime in seconds; values shorter than 7 days are rejected.
GROKIQ_JWT_TTL_SECONDS=604800
GROKIQ_CORS_ORIGINS=https://monitor.lvyrix.com,http://localhost:8091,http://127.0.0.1:8091

# Initial runtime values. After first start these can be maintained in the UI.
GROKIQ_GROK2API_BASE_URL=http://127.0.0.1:8000
GROKIQ_GROK2API_ADMIN_USERNAME=
GROKIQ_GROK2API_ADMIN_PASSWORD=
GROKIQ_GROK2API_HTTP_IMPERSONATE=chrome

GROKIQ_GROK_REGISTER_WEBHOOK_TOKEN=
# Optional SSO detection proxy. Empty allows direct egress.
GROKIQ_SSO_PROXY=
GROKIQ_INITIAL_PROBE_ON_REGISTER=true
GROKIQ_REGISTER_PROBE_STABILIZATION_SECONDS=15
GROKIQ_REGISTER_PROBE_PROFILE_IDS=["quality-marker"]
GROKIQ_REGISTER_PROBE_EXECUTION_MODE=chat
GROKIQ_REGISTER_PROBE_ROUNDS=3
GROKIQ_REGISTER_PROBE_PROXY_TARGETS=[{"kind":"current","id":null}]

# WeChat public-platform test account template notifications (runtime settings)
GROKIQ_WECHAT_NOTIFICATION_ENABLED=false
GROKIQ_WECHAT_APP_ID=
GROKIQ_WECHAT_APP_SECRET=
GROKIQ_WECHAT_OPENID=
GROKIQ_WECHAT_TEMPLATE_ID=

# Optional /status login gate (runtime settings; default off = public access).
# When enabled, visitors can use Linux.do Connect or invite-code local accounts.
GROKIQ_STATUS_LINUXDO_OAUTH_ENABLED=false
GROKIQ_LINUXDO_OAUTH_CLIENT_ID=
GROKIQ_LINUXDO_OAUTH_CLIENT_SECRET=
GROKIQ_LINUXDO_OAUTH_REDIRECT_URI=

GROKIQ_SCHEDULER_ENABLED=true
GROKIQ_QUARANTINE_RECOVERY_ENABLED=true
GROKIQ_SCHEDULER_TIMEZONE=UTC
GROKIQ_SCHEDULER_MISFIRE_GRACE_SECONDS=300
GROKIQ_RECOVERY_CRON=*/5 * * * *

GROKIQ_PROBE_WORKER_CONCURRENCY=2
GROKIQ_PROBE_QUEUE_LIMIT=10000
GROKIQ_PROBE_STEP_DELAY_SECONDS=0.6
GROKIQ_PROBE_TRANSIENT_RETRY_ATTEMPTS=2
GROKIQ_PROBE_TRANSIENT_RETRY_BASE_SECONDS=5
GROKIQ_PROBE_TRANSIENT_RETRY_MAX_SECONDS=30
GROKIQ_PROBE_ROUTE_PREFIX=grokiq-probe
GROKIQ_PROBE_DIAGNOSTIC_PRIORITY=-1000000

GROKIQ_ANALYSIS_WINDOW_HOURS=168
GROKIQ_DEGRADATION_TPS=150
GROKIQ_STRONG_DEGRADATION_TPS=500
GROKIQ_CONSECUTIVE_ANOMALIES=3
GROKIQ_CUMULATIVE_ANOMALY_RATE=0.5
GROKIQ_HIGH_RISK_HARD_COUNT=2
GROKIQ_RISK_ANOMALY_RATE_WEIGHT=30
GROKIQ_RISK_HARD_WEIGHT=6
GROKIQ_RISK_HARD_CAP=24
GROKIQ_RISK_FAST_WEIGHT=12
GROKIQ_RISK_FAST_CAP=30
GROKIQ_RISK_MARKER_MISS_WEIGHT=16
GROKIQ_RISK_MARKER_MISS_CAP=32
GROKIQ_RISK_STREAK_WEIGHT=3
GROKIQ_RISK_STREAK_CAP=15
GROKIQ_RISK_SCORE_CAP=100
GROKIQ_RISK_WATCH_FLOOR=15
GROKIQ_RISK_SUSPECT_FLOOR=50
GROKIQ_RISK_HIGH_FLOOR=75
GROKIQ_BUFFER_FIRST_TOKEN_SHARE=0.85
GROKIQ_MIN_GENERATION_MS=250
GROKIQ_MINIMUM_OUTPUT_TOKENS=32
GROKIQ_AUTO_QUARANTINE=false
GROKIQ_QUARANTINE_MINUTES=30

# Docker Compose images and published ports
GROKIQ_BACKEND_IMAGE=ghcr.io/kaibush/grok-iq-backend:latest
GROKIQ_FRONTEND_IMAGE=ghcr.io/kaibush/grok-iq-frontend:latest
GROKIQ_WEB_PORT=8091
GROKIQ_API_PORT=8090
